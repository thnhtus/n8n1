{
  "name": "TikTok Login (agent-browser)",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "command": "cd /Users/thanhtu1/persona/n8n1 && node scripts/tiktok-login.js; echo \"EXIT=$?\""
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Run agent-browser login",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const out = $json.stdout || '';\nconst line = out.split('\\n').reverse().find((l) => l.trim().startsWith('{'));\nlet result = { status: 'error', raw: out, stderr: $json.stderr };\ntry { if (line) result = JSON.parse(line); } catch {}\nreturn [{ json: result }];"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ ['success','already_authenticated'].includes($json.status) }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Logged in?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.cookiesFile }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Read cookies file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [880, -100]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'TikTok login: ' + $json.status + ' — ' + ($json.hint || '') }}"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Needs human (CAPTCHA / creds)",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [880, 100]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Run agent-browser login", "type": "main", "index": 0 }]] },
    "Run agent-browser login": { "main": [[{ "node": "Parse result", "type": "main", "index": 0 }]] },
    "Parse result": { "main": [[{ "node": "Logged in?", "type": "main", "index": 0 }]] },
    "Logged in?": {
      "main": [
        [{ "node": "Read cookies file", "type": "main", "index": 0 }],
        [{ "node": "Needs human (CAPTCHA / creds)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
