# Video Factory — Root Configuration
# Storage: ~/video-factory/data/

# RustFS Object Storage (Local S3)
RUSTFS_ACCESS_KEY=factory_admin
RUSTFS_SECRET_KEY=factory_secret_key_change_me
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_BUCKET=video-factory

# 9Router Local Gateway
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_DEFAULT_MODEL=free-tier-rouding
ROUTER_VISION_MODEL=cmd-claude

# Local Data Root
FACTORY_DATA_DIR=./data

# Auto-post only when lint is clean. Default: hand-off to out/<id>/ for review.
AUTO_PUBLISH=false

# TikTok Content Posting API (Direct Post)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=
# TIKTOK_PRIVACY=SELF_ONLY

# YouTube Data API v3 (resumable upload)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_PRIVACY=private

# Meta Reels (needs PUBLIC_VIDEO_BASE reachable from internet)
# META_ACCESS_TOKEN=
# META_PAGE_ID=
# META_PRIVACY=SELF
# PUBLIC_VIDEO_BASE=

# Multi-platform publish list for n8n workflow (comma-separated)
# VF_PLATFORMS=tiktok

# Analytics / trends
# TREND_MODEL=gemini/gemini-3.1-flash-lite-preview
# CONTENT_QUEUE=content/queue.json
